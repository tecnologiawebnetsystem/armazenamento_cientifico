# Armazenamento Científico API — configuração local
# Opção recomendada para testar localmente:
# 1. Suba um PostgreSQL local: docker compose -f docker-compose.local.yml up -d
# 2. Execute: psql "$DATABASE_URL" -f ../database/projects-schema.sql
# Use sqlite no desenvolvimento local ou postgres no servidor.
DATABASE_ENGINE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./data/sigac.db
SEED_DATABASE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_NAME=wayon_session_id
COOKIE_SECURE=false
SESSION_HOURS=8
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
DB_MIN_SIZE=1
DB_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
API_PREFIX=/api
EXPOSE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
REQUEST_LOG_MAX_ID_LENGTH=100
AUDIT_RETENTION_DAYS=365
COOKIE_DOMAIN=

# Microsoft Entra ID — mantenha os valores reais somente em backend/.env.
# O callback deve ser registrado exatamente no App Registration do Entra ID.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-backend-only-secret
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/entra/callback
# Escopos separados por espaço, conforme permissões delegadas do App Registration.
ENTRA_SCOPES=openid profile email User.Read GroupMember.Read.All
# IDs ou nomes de grupos permitidos, separados por vírgula. Deixe vazio para não restringir por grupo.
ENTRA_GROUPS=
ENTRA_GROUP_SYNC_ENABLED=true
