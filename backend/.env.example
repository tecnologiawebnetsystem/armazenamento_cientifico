# Armazenamento Científico API — configuração local
# Opção recomendada para testar localmente:
# 1. Suba um PostgreSQL local: docker compose -f docker-compose.local.yml up -d
# 2. Execute: psql "$DATABASE_URL" -f ../database/projects-schema.sql
# Para usar Neon, substitua DATABASE_URL pela connection string fornecida pela integração.
DATABASE_URL=postgresql://armazenamento:armazenamento@localhost:5432/armazenamento_cientifico
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_NAME=wayon_session_id
COOKIE_SECURE=false
SESSION_HOURS=8
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO
DB_MIN_SIZE=1
DB_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
API_PREFIX=/api
EXPOSE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
REQUEST_LOG_MAX_ID_LENGTH=100
AUDIT_RETENTION_DAYS=365
COOKIE_DOMAIN=
