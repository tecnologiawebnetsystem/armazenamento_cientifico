# Armazenamento Científico API — escolha do banco pelo .env
# Use apenas uma configuração de DATABASE_ENGINE e DATABASE_URL por vez.
# SQLite: banco local em backend/data/sigac.db
# PostgreSQL: use a DATABASE_URL fornecida pela integração PostgreSQL, com SSL.

# --- SQLite local ---
 DATABASE_ENGINE=sqlite
 DATABASE_URL=sqlite+aiosqlite:///./data/sigac.db
 SEED_DATABASE=true
 ENVIRONMENT=development
 COOKIE_SECURE=false

# --- PostgreSQL ---
# DATABASE_ENGINE=postgresql
# DATABASE_URL=postgresql://usuario:senha@host/postgresqldb?sslmode=require
# Em produção, não habilite seed automaticamente.
# SEED_DATABASE=false
# DATABASE_URL_UNPOOLED pode ser usada para migrations/operações diretas.
# Nunca versione credenciais reais.

# --- OUTRAS VARIÁVEIS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_NAME=wayon_session_id
COOKIE_SECURE=false
SESSION_HOURS=8
ENVIRONMENT=development
PORT=8080
LOG_LEVEL=INFO
DB_MIN_SIZE=1
DB_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
API_PREFIX=/api
EXPOSE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
REQUEST_LOG_MAX_ID_LENGTH=100
AUDIT_RETENTION_DAYS=365
COOKIE_DOMAIN=

# Microsoft Entra ID — mantenha os valores reais somente em backend/.env.
# O callback deve ser registrado exatamente no App Registration do Entra ID.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-backend-only-secret
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/entra/callback
# Escopos separados por espaço, conforme permissões delegadas do App Registration.
ENTRA_SCOPES=openid profile email User.Read GroupMember.Read.All
# IDs ou nomes de grupos permitidos, separados por vírgula. Deixe vazio para não restringir por grupo.
ENTRA_GROUPS=
ENTRA_GROUP_SYNC_ENABLED=true
