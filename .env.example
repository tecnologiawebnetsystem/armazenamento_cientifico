# SIGAC Web — exemplo de configuração

# URL pública da API usada pelo navegador.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# URL interna usada pelo proxy Next.js em Docker/Compose.
BACKEND_INTERNAL_URL=http://host.docker.internal:8080
# Identificação do ambiente exposta ao frontend.
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Docker/JFrog — usados pelo docker-compose
# -----------------------------------------------------------------------------
JFROG_REGISTRY=jfrog.petrobras.dev.br
JFROG_DOCKER_REPOSITORY=
IMAGE_TAG=local
# Credenciais temporárias apenas para login local no registry; nunca versionar.
JFROG_USER=
JFROG_TOKEN=

# Os segredos CAV4, Entra ID e Aurora pertencem exclusivamente ao back-end/.env.
