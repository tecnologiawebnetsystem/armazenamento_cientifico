# SIGAC Web — variáveis necessárias ao frontend

# URL pública da API usada no navegador.
# Em desenvolvimento local, deixe vazia para usar o rewrite /api/* do Next.js.
# Em produção, informe a URL pública do FastAPI.
NEXT_PUBLIC_API_BASE_URL=

# URL interna usada pelo rewrite do Next.js para alcançar o FastAPI.
# Docker Compose normalmente usa http://host.docker.internal:8080.
BACKEND_INTERNAL_URL=http://localhost:8080

# Identificação não sensível do ambiente exibida pelo frontend.
NEXT_PUBLIC_APP_ENV=development

# Não coloque aqui credenciais CAV4, Entra ID, banco, AWS ou tokens.
# Esses valores pertencem exclusivamente ao back-end/.env.
