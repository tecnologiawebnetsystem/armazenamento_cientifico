# URL pública usada pelo navegador
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# URL usada pelo servidor Next.js quando executado em container
BACKEND_INTERNAL_URL=http://host.docker.internal:8080
NEXT_PUBLIC_APP_ENV=development

# OIDC corporativo é iniciado pelo backend; não coloque segredos aqui.
# ENTRA_CLIENT_SECRET e CAV4_CLIENT_SECRET pertencem somente ao back-end/.env.

# JFrog Artifactory Docker Registry
# O host PyPI (/artifactory/api/pypi/...) não deve ser usado para imagens Docker.
JFROG_REGISTRY=jfrog.petrobras.dev.br
JFROG_DOCKER_REPOSITORY=informar-repositorio-docker
IMAGE_TAG=local
# Usados somente no login local; nunca versione credenciais.
JFROG_USER=
JFROG_TOKEN=
