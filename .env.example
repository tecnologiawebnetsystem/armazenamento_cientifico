# SIGAC Web — configuração do frontend
# Copie para .env.local no desenvolvimento.
# Não coloque aqui segredos, tokens, credenciais CAV4 ou variáveis do banco.

# ----------------------------------------------------------------------------
# API acessada pelo frontend
# ----------------------------------------------------------------------------
# Em desenvolvimento, deixe vazio: o Next.js usa o rewrite /api/* para
# http://localhost:8080. Em deploy, informe a URL pública do backend sem /api.
NEXT_PUBLIC_API_BASE_URL=

# URL interna usada pelo rewrite do Next.js em produção/Docker.
# Em desenvolvimento local, normalmente é localhost:8080.
BACKEND_INTERNAL_URL=http://localhost:8080

# ----------------------------------------------------------------------------
# Identificação visual
# ----------------------------------------------------------------------------
# Apenas informa o ambiente mostrado na interface; não controla segurança.
NEXT_PUBLIC_APP_ENV=development

# Login manual por e-mail: false mantém somente o SSO CAv4.
NEXT_PUBLIC_EMAIL_LOGIN_ENABLED=false

# Exemplos:
# local:
#   NEXT_PUBLIC_API_BASE_URL=
#   BACKEND_INTERNAL_URL=http://localhost:8080
#   NEXT_PUBLIC_APP_ENV=development
# staging:
#   NEXT_PUBLIC_API_BASE_URL=https://api-staging.exemplo.com
#   BACKEND_INTERNAL_URL=https://backend-staging.internal
#   NEXT_PUBLIC_APP_ENV=staging
# produção:
#   NEXT_PUBLIC_API_BASE_URL=https://api.exemplo.com
#   BACKEND_INTERNAL_URL=https://backend.internal
#   NEXT_PUBLIC_APP_ENV=production

# O backend possui configuração própria em back-end/.env.example.
