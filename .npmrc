# Registro público padrão. NÃO fixar aqui a URL do JFrog interno da
# Petrobras: isso quebra qualquer ambiente sem acesso à VPN corporativa
# (sandboxes de teste, runners de CI/CD, novos desenvolvedores). Quem estiver
# na rede da Petrobras e quiser usar o mirror interno deve configurá-lo no
# ~/.npmrc pessoal ou via variável de ambiente, por exemplo:
#   npm_config_registry=https://jfrog.petrobras.dev.br/artifactory/api/npm/npm-group-all/ npm install
registry=https://registry.npmjs.org/
legacy-peer-deps=true
audit=false
fund=false
progress=false
