# JFrog Artifactory Docker Registry
# O host PyPI (/artifactory/api/pypi/...) não deve ser usado para imagens Docker.
JFROG_REGISTRY=jfrog.petrobras.dev.br
JFROG_DOCKER_REPOSITORY=informar-repositorio-docker
IMAGE_TAG=local
# Usados somente no login local; nunca versione credenciais.
JFROG_USER=
JFROG_TOKEN=

# Armazenamento Científico API — escolha do banco pelo .env
# A aplicação não utiliza DATABASE_URL. Em produção, use as variáveis Aurora abaixo.

# --- SQLite local ---
DATABASE_ENGINE=sqlite
DATABASE_URL_SQLITE=sqlite+aiosqlite:///./data/sigac.db
SEED_DATABASE=true
ENVIRONMENT=development
COOKIE_SECURE=false

# --- Amazon Aurora PostgreSQL ---
# DATABASE_ENGINE=postgresql
# Informe a URL completa OU os componentes abaixo (a URL completa tem prioridade).
# RDS_AURORA_POSTGRES_URL=postgresql://usuario:senha@host:5432/armazenamento_cientifico?sslmode=require
# RDS_AURORA_POSTGRES_HOST=
# RDS_AURORA_POSTGRES_PORT=5432
# RDS_AURORA_POSTGRES_DATABASE=armazenamento_cientifico
# RDS_AURORA_POSTGRES_USERNAME=
# RDS_AURORA_POSTGRES_PASSWORD=
# Em produção, não habilite seed automaticamente.
# SEED_DATABASE=false
# Nunca versione credenciais reais.

# --- OUTRAS VARIÁVEIS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_NAME=wayon_session_id
SESSION_HOURS=8
ENVIRONMENT=development
PORT=8080
LOG_LEVEL=INFO
DB_MIN_SIZE=1
DB_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
API_PREFIX=/api
EXPOSE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
AUDIT_RETENTION_DAYS=365
COOKIE_DOMAIN=

# Microsoft Entra ID — mantenha os valores reais somente em back-end/.env.
# O callback deve ser registrado exatamente no App Registration do Entra ID.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-backend-only-secret
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/entra/callback
# Escopos separados por espaço, conforme permissões delegadas do App Registration.
ENTRA_SCOPES=openid profile email User.Read GroupMember.Read.All
# IDs ou nomes de grupos permitidos, separados por vírgula. Deixe vazio para não restringir por grupo.
ENTRA_GROUPS=
ENTRA_GROUP_SYNC_ENABLED=true
ENTRA_AUTO_CREATE_USER=false
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
ENTRA_ISSUER=
ENTRA_AUTHORITY=

# CAV4 — habilitar somente após receber o contrato oficial do provedor.
CAV4_ENABLED=false
CAV4_BASE_URL=
CA_CLIENT_ID=
CA_CLIENT_SECRET=
CA_REDIRECT_URI=http://localhost:8080/api/auth/cav4/callback
CA_SCOPES=openid profile email
CA_AUTHORIZATION_URL=
CA_TOKEN_URL=
CA_USERINFO_URL=
CA_LOGOUT_URL=
CA_ISSUER=
CA_JWKS_URL=
CAV4_AUDIENCE=
CAV4_API_KEY=
