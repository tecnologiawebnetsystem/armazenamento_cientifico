# JFrog Artifactory Docker Registry
# O host PyPI (/artifactory/api/pypi/...) não deve ser usado para imagens Docker.
JFROG_REGISTRY=jfrog.petrobras.dev.br
JFROG_DOCKER_REPOSITORY=informar-repositorio-docker
IMAGE_TAG=local
# Usados somente no login local; nunca versione credenciais.
JFROG_USER=
JFROG_TOKEN=

# Armazenamento Científico API — somente PostgreSQL Aurora
# Informe DATABASE_URL ou o conjunto PGHOST/PGDATABASE/PGUSER.
# Conexões Aurora devem usar TLS; nunca versione credenciais reais.
DATABASE_ENGINE=postgresql
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
AWS_REGION=
AWS_ROLE_ARN=
VERCEL_OIDC_TOKEN=
SEED_DATABASE=false
ENVIRONMENT=development
COOKIE_SECURE=false

# --- OUTRAS VARIÁVEIS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_NAME=wayon_session_id
SESSION_HOURS=8
ENVIRONMENT=development
PORT=8080
LOG_LEVEL=INFO
DB_MIN_SIZE=1
DB_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
API_PREFIX=/api
EXPOSE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
AUDIT_RETENTION_DAYS=365
COOKIE_DOMAIN=

# Microsoft Entra ID — mantenha os valores reais somente em back-end/.env.
# O callback deve ser registrado exatamente no App Registration do Entra ID.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-with-backend-only-secret
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/entra/callback
# Escopos separados por espaço, conforme permissões delegadas do App Registration.
ENTRA_SCOPES=openid profile email User.Read GroupMember.Read.All
# IDs ou nomes de grupos permitidos, separados por vírgula. Deixe vazio para não restringir por grupo.
ENTRA_GROUPS=
ENTRA_GROUP_SYNC_ENABLED=true
ENTRA_AUTO_CREATE_USER=false
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login
ENTRA_ISSUER=
ENTRA_AUTHORITY=

# CAV4 — habilitar somente após receber o contrato oficial do provedor.
CAV4_ENABLED=false
CAV4_BASE_URL=
# OIDC Discovery é preferível a informar endpoints manualmente.
OIDC_DISCOVERY_URL=
CA_API_BASE_URL=
CA_SSL_USE_TRUSTSTORE=true
CA_SSL_CERT_FILE=
CA_SSL_VERIFY=true
CA_CLIENT_ID=
CA_CLIENT_SECRET=
CA_REDIRECT_URI=http://localhost:8080/api/auth/cav4/callback
CA_SCOPES=openid profile email
CA_AUTHORIZATION_URL=
CA_TOKEN_URL=
CA_USERINFO_URL=
CA_LOGOUT_URL=
CA_ISSUER=
CA_JWKS_URL=
CAV4_AUDIENCE=
CAV4_API_KEY=
