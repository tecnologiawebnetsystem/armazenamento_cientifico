# SIGAC API — exemplo de configuração
# Não coloque segredos reais neste arquivo.

# -----------------------------------------------------------------------------
# AWS / Aurora PostgreSQL
# -----------------------------------------------------------------------------
# Variáveis oficiais de conexão com o Amazon Aurora PostgreSQL.
RDS_AURORA_POSTGRES_HOST=
RDS_AURORA_POSTGRES_USERNAME=
RDS_AURORA_POSTGRES_PASSWORD=
RDS_AURORA_POSTGRES_DATABASE=
RDS_AURORA_POSTGRES_URL=
# DATABASE_ENGINE: motor lógico utilizado pela aplicação.
DATABASE_ENGINE=postgresql
# DB_SCHEMA: schema PostgreSQL da aplicação.
DB_SCHEMA=public
# true valida a CA; false mantém TLS ativo sem validar o certificado.
DB_SSL_VERIFY=false
DB_SSL_CA_FILE=
DB_MIN_SIZE=1
DB_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30

# -----------------------------------------------------------------------------
# Aplicação e sessão
# -----------------------------------------------------------------------------
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_NAME=wayon_session_id
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_HOURS=8
API_PREFIX=/api
PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=pretty
# EXPOSE_API_DOCS: habilita Swagger em /docs, ReDoc em /redoc e OpenAPI em /openapi.json.
# Pode ser true em produção; proteja o acesso por rede, gateway ou autenticação quando necessário.
EXPOSE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
AUDIT_RETENTION_DAYS=365
# Use somente em desenvolvimento sem banco persistente.
TEMPORARY_CAV4_SESSION=false

# -----------------------------------------------------------------------------
# CAV4 — autenticação OIDC; não fornece papéis nem permissões do SIGAC
# -----------------------------------------------------------------------------
CAV4_ENABLED=false
CA_CLIENT_ID=
CA_CLIENT_SECRET=
CA_REDIRECT_URI=http://localhost:8080/api/auth/cav4/callback
CA_SCOPES=openid profile email
OIDC_DISCOVERY_URL=
CA_API_BASE_URL=
CA_ISSUER=
CA_JWKS_URL=
# Em desenvolvimento, false permite usar o CAV4 sem CA corporativa instalada.
# Em produção, mantenha true e instale a cadeia de confiança no servidor.
CA_SSL_VERIFY=false
CA_SSL_USE_TRUSTSTORE=false
CA_SSL_CERT_FILE=
CAV4_JWT_LEEWAY_SECONDS=120

# -----------------------------------------------------------------------------
# Microsoft Entra ID — somente se este provedor alternativo for habilitado
# -----------------------------------------------------------------------------
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8080/api/auth/entra/callback
ENTRA_SCOPES=openid profile email User.Read GroupMember.Read.All
ENTRA_GROUPS=
ENTRA_GROUP_SYNC_ENABLED=true

# -----------------------------------------------------------------------------
# Docker/JFrog — usados apenas por docker-compose e login do registry
# -----------------------------------------------------------------------------
JFROG_REGISTRY=jfrog.petrobras.dev.br
JFROG_DOCKER_REPOSITORY=
IMAGE_TAG=local
JFROG_USER=
JFROG_TOKEN=
