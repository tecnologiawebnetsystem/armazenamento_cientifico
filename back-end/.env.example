# SIGAC — configuração do backend
# Este arquivo é um modelo. Nunca coloque segredos reais no Git.
# Para desenvolvimento, copie para back-end/.env.

# -----------------------------------------------------------------------------
# Banco PostgreSQL/Aurora
# -----------------------------------------------------------------------------
# Use a URL completa OU o conjunto host/usuário/senha/banco.
RDS_AURORA_POSTGRES_URL=
# RDS_AURORA_POSTGRES_HOST=
# RDS_AURORA_POSTGRES_USERNAME=
# RDS_AURORA_POSTGRES_PASSWORD=
# RDS_AURORA_POSTGRES_DATABASE=sigac
DATABASE_ENGINE=postgresql
DB_SCHEMA=public
DB_SSL_VERIFY=false
DB_SSL_CA_FILE=
DB_MIN_SIZE=1
DB_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30

# -----------------------------------------------------------------------------
# Aplicação e sessão
# -----------------------------------------------------------------------------
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_NAME=wayon_session_id
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_HOURS=8
API_PREFIX=/api
PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=pretty
EXPOSE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
AUDIT_RETENTION_DAYS=365
# Use somente para desenvolvimento sem banco persistente.
TEMPORARY_CAV4_SESSION=false
# Login local temporário; mantenha false quando o login CAV4 for obrigatório.
EMAIL_LOGIN_ENABLED=false

# -----------------------------------------------------------------------------
# CAV4 — único provedor de autenticação do SIGAC
# -----------------------------------------------------------------------------
CAV4_ENABLED=false
CA_CLIENT_ID=
CA_CLIENT_SECRET=
CA_REDIRECT_URI=http://localhost:8080/api/auth/cav4/callback
CA_SCOPES=openid profile email
OIDC_DISCOVERY_URL=
CA_API_BASE_URL=
CA_ISSUER=
CA_JWKS_URL=
CA_USERINFO_URL=
CA_SSL_VERIFY=false
CA_SSL_USE_TRUSTSTORE=false
CA_SSL_CERT_FILE=
CAV4_JWT_LEEWAY_SECONDS=120

# -----------------------------------------------------------------------------
# Opcional: somente execução via Docker/JFrog
# -----------------------------------------------------------------------------
# JFROG_REGISTRY=
# JFROG_DOCKER_REPOSITORY=
# IMAGE_TAG=local
# JFROG_USER=
# JFROG_TOKEN=

# Não adicionar aqui CLIENT_SECRET, API keys ou tokens do frontend.
# As variáveis de Entra ID foram removidas deste modelo porque o fluxo atual
# do SIGAC autentica exclusivamente pelo CAV4.
