# SIGAC — configuração do backend
# Copie para back-end/.env e preencha os valores do ambiente.
# Nunca versione segredos reais.

# ----------------------------------------------------------------------------
# Banco de dados (obrigatório quando TEMPORARY_CAV4_SESSION=false)
# ----------------------------------------------------------------------------
# Preferencial: URL PostgreSQL/Aurora completa.
RDS_AURORA_POSTGRES_URL=
# Alternativa à URL: preencha todos os campos abaixo e remova/comente a URL.
# Esses nomes são compatíveis com as variáveis injetadas no AWS/Aurora.
# RDS_AURORA_POSTGRES_HOST=
# RDS_AURORA_POSTGRES_USERNAME=
# RDS_AURORA_POSTGRES_PASSWORD=
# RDS_AURORA_POSTGRES_DATABASE=sigac
#
# Também são aceitos por compatibilidade: POSTGRES_HOST, POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_DATABASE e PGHOST/PGUSER/PGPASSWORD/PGDATABASE.

DB_SCHEMA=public
DB_SSL_VERIFY=false
# DB_SSL_CA_FILE=/caminho/da/CA.pem
DB_MIN_SIZE=1
DB_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30

# ----------------------------------------------------------------------------
# Aplicação, CORS e sessão
# ----------------------------------------------------------------------------
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_NAME=wayon_session_id
COOKIE_SECURE=false
# COOKIE_DOMAIN=.empresa.com
SESSION_HOURS=8
LOG_LEVEL=INFO
LOG_FORMAT=pretty
EXPOSE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
AUDIT_RETENTION_DAYS=365

# Login por e-mail: habilitado em development/staging; desabilite em produção
# quando o acesso corporativo CAV4 for o único método permitido.
EMAIL_LOGIN_ENABLED=true
# Somente testes locais sem banco. Nunca habilite em homologação/produção.
TEMPORARY_CAV4_SESSION=false

# ----------------------------------------------------------------------------
# CAV4 / OIDC corporativo
# ----------------------------------------------------------------------------
CAV4_ENABLED=false
# Obrigatórias quando CAV4_ENABLED=true:
CA_CLIENT_ID=
CA_CLIENT_SECRET=
CA_REDIRECT_URI=http://localhost:8080/api/auth/cav4/callback
CA_SCOPES=openid profile email
OIDC_DISCOVERY_URL=

# Desenvolvimento pode usar false apenas quando o certificado interno não está
# instalado. Homologação e produção devem usar true e uma CA confiável.
CA_SSL_VERIFY=false
CA_SSL_USE_TRUSTSTORE=false
# CA_SSL_CERT_FILE=/caminho/da/CA.pem

# O endpoint de login, token e JWKS deve vir do OIDC_DISCOVERY_URL.
# Só preencha os overrides abaixo se o discovery do CAV4 não os fornecer.
# CA_AUTHORIZATION_URL=
# CA_TOKEN_URL=
# CA_ISSUER=
# CA_JWKS_URL=
# CA_USERINFO_URL=  # opcional: fallback se o id_token não trouxer e-mail
# CA_API_BASE_URL=  # necessário para consultar UserInfo/recursos
# CA_RESOURCES_URL=/api/admin/users/{userLogin}/roles  # endpoint de papéis do usuário
CAV4_JWT_LEEWAY_SECONDS=120

# ----------------------------------------------------------------------------
# CI/CD (somente quando docker-compose/CI for usado)
# ----------------------------------------------------------------------------
# JFROG_REGISTRY=jfrog.petrobras.dev.br
# JFROG_DOCKER_REPOSITORY=
# IMAGE_TAG=local
# JFROG_USER=
# JFROG_TOKEN=

# Produção: ENVIRONMENT=production, COOKIE_SECURE=true, CA_SSL_VERIFY=true,
# CAV4_ENABLED=true, EMAIL_LOGIN_ENABLED=false e EXPOSE_API_DOCS=false.
# O frontend possui seu próprio arquivo ../.env.example.
# O código aceita aliases antigos CAV4_* e DATABASE_URL/POSTGRES_* por compatibilidade,
# mas novos ambientes devem usar os nomes acima.
