# SIGAC — variáveis do backend
# Copie este arquivo para back-end/.env e preencha os valores do ambiente.
# Nunca versione segredos reais.
#
# Legenda:
#   [OBRIGATÓRIA] precisa ser preenchida para o cenário indicado.
#   [OPCIONAL] possui valor padrão ou só é necessária em casos específicos.
#
# Valores locais normalmente usam localhost e validação TLS desativada.
# Homologação e produção devem usar URLs reais, TLS ativo e COOKIE_SECURE=true.

# =============================================================================
# 1. BANCO DE DADOS — obrigatório quando TEMPORARY_CAV4_SESSION=false
# =============================================================================
# Use a URL completa. É a opção recomendada.
RDS_AURORA_POSTGRES_URL=

# Alternativa à URL completa: preencha o conjunto inteiro abaixo.
# RDS_AURORA_POSTGRES_HOST=
# RDS_AURORA_POSTGRES_USERNAME=
# RDS_AURORA_POSTGRES_PASSWORD=
# RDS_AURORA_POSTGRES_DATABASE=sigac

# [OBRIGATÓRIA] schema usado pelas tabelas do SIGAC.
DB_SCHEMA=public
DATABASE_ENGINE=postgresql

# Segurança e pool de conexões.
DB_SSL_VERIFY=false
# DB_SSL_CA_FILE=/caminho/da/CA.pem
DB_MIN_SIZE=1
DB_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30

# =============================================================================
# 2. APLICAÇÃO, CORS E SESSÃO
# =============================================================================
# [OBRIGATÓRIA] development, staging/homolog ou production.
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

API_PREFIX=/api
COOKIE_NAME=wayon_session_id
# Local: false | homologação/produção: true
COOKIE_SECURE=false
# Necessário apenas quando o cookie atravessa subdomínios.
COOKIE_DOMAIN=
SESSION_HOURS=8
LOG_LEVEL=INFO
LOG_FORMAT=pretty
# Local/homologação: true para diagnóstico | produção: false
EXPOSE_API_DOCS=true
SECURITY_HEADERS_ENABLED=true
AUDIT_RETENTION_DAYS=365

# Fluxo de autenticação do SIGAC.
# Produção deve manter TEMPORARY_CAV4_SESSION=false.
TEMPORARY_CAV4_SESSION=false
# Login por e-mail local não substitui o CAV4; mantenha false.
EMAIL_LOGIN_ENABLED=false

# =============================================================================
# 3. CAV4 — autenticação corporativa
# =============================================================================
# [OBRIGATÓRIA em homologação/produção] true ativa o login corporativo.
CAV4_ENABLED=false
# [OBRIGATÓRIA quando CAV4_ENABLED=true]
CA_CLIENT_ID=
CA_CLIENT_SECRET=
CA_REDIRECT_URI=http://localhost:8080/api/auth/cav4/callback
CA_SCOPES=openid profile email
OIDC_DISCOVERY_URL=

# TLS: local pode usar false; homologação/produção devem usar true.
CA_SSL_VERIFY=false
# Só habilite se a infraestrutura exigir truststore/certificado corporativo.
CA_SSL_USE_TRUSTSTORE=false
# CA_SSL_CERT_FILE=/caminho/da/CA.pem

# Endpoints opcionais. O discovery OIDC é preferencial; preencha apenas
# quando o CAV4 não publicar esses endpoints no documento de discovery.
# CA_AUTHORIZATION_URL=
# CA_TOKEN_URL=
# CA_USERINFO_URL=
# CA_JWKS_URL=
# CA_ISSUER=
# CA_LOGOUT_URL=
# CA_API_BASE_URL=
CAV4_JWT_LEEWAY_SECONDS=120

# =============================================================================
# 4. FERRAMENTAS DE DESENVOLVIMENTO (não são runtime do SIGAC)
# =============================================================================
# Use somente em pipelines de Docker/JFrog; não são necessárias para executar
# o backend local ou no ambiente de produção já configurado.
# JFROG_REGISTRY=
# JFROG_DOCKER_REPOSITORY=
# IMAGE_TAG=local
# JFROG_USER=
# JFROG_TOKEN=

# Não incluir aqui variáveis NEXT_PUBLIC_*, credenciais do frontend ou Entra ID.
# O SIGAC usa exclusivamente CAV4 para autenticação corporativa.

# Valores por ambiente (resumo):
# local: ENVIRONMENT=development, URLs localhost, COOKIE_SECURE=false,
#        CA_SSL_VERIFY=false, EXPOSE_API_DOCS=true
# homologação: ENVIRONMENT=staging, URLs do ambiente, COOKIE_SECURE=true,
#        CA_SSL_VERIFY=true, CAV4_ENABLED=true
# produção: ENVIRONMENT=production, URLs do ambiente, COOKIE_SECURE=true,
#            CA_SSL_VERIFY=true, EXPOSE_API_DOCS=false, CAV4_ENABLED=true
# Segredos (URL do banco, CA_CLIENT_SECRET e certificados) mudam por ambiente.

# Compatibilidade: o código ainda aceita CAV4_CLIENT_ID/CAV4_CLIENT_SECRET,
# CAV4_REDIRECT_URI/CAV4_SCOPES e CAV4_BASE_URL, mas novos ambientes devem
# utilizar os nomes CA_* acima.

# Fim do modelo.
