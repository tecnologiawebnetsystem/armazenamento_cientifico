uv.lock
Pipfile.lock
poetry.lock

# Bancos locais e artefatos de migração manual
*.db
*.sqlite
*.sqlite3
data/*.db

# Logs
*.log

# Sistema operacional / editor
.DS_Store
Thumbs.db
